## Backend (server.js)
# Port for API server (Render/Railway usually provide PORT automatically)
API_PORT=4000

# Comma-separated emails that should be admins (case-insensitive)
ADMIN_EMAILS=admin@example.com

# Postgres connection string (Supabase/Neon/Render/Railway)
DATABASE_URL=postgres://user:password@host:5432/dbname

# SSL for managed Postgres (Supabase/Neon usually require ssl)
DATABASE_SSL=true

## Payments (Stripe)
# Stripe secret key (starts with sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_...)
STRIPE_WEBHOOK_SECRET=

# Public base URL for success/cancel redirects. Example: http://localhost:4000
# If empty, server will infer from request host.
PUBLIC_BASE_URL=

# Fixed deposit amount in KZT
PAYMENT_DEPOSIT_KZT=5000
